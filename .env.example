# ForgeMind AI Operations - Environment Configuration
# Copy this file to .env and replace placeholder values

# ============================================================================
# Database Configuration
# ============================================================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=forgemind
POSTGRES_USER=forgemind
POSTGRES_PASSWORD=changeme_in_production
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ============================================================================
# Redis Configuration
# ============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme_in_production
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0

# ============================================================================
# Backend Configuration
# ============================================================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=4
BACKEND_LOG_LEVEL=INFO
SECRET_KEY=changeme_generate_32_random_bytes
API_V1_PREFIX=/api/v1

# ============================================================================
# Frontend Configuration
# ============================================================================
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/ws

# ============================================================================
# AI/LLM Configuration
# ============================================================================
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3

# ============================================================================
# Chat Provider Configuration (independent of embedding provider)
# ============================================================================
# CHAT_PROVIDER_MODE selects the chat provider:
#   fake      — deterministic offline provider (development/CI default; no key)
#   openai    — OpenAI (requires OPENAI_API_KEY above)
#   chain     — ordered external fallback chain (Groq → OpenRouter)
# Production/staging never silently select fake.
CHAT_PROVIDER_MODE=fake
# Ordered fallback chain (server-configured; a client cannot reorder it).
CHAT_PROVIDER_CHAIN=groq,openrouter
# Structured-output capability mode per provider:
#   json_schema  — strict JSON Schema response formatting (provider/model must support it)
#   json_object  — provider JSON-object mode (server-side validation remains authoritative)
#   prompt_json  — explicit prompt-only JSON compatibility mode (no response_format)
OPENAI_STRUCTURED_OUTPUT_MODE=json_schema

# Groq (free primary external provider)
GROQ_API_KEY=your-groq-api-key-here
GROQ_API_BASE=https://api.groq.com/openai/v1
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_STRUCTURED_OUTPUT_MODE=json_schema

# OpenRouter (paid commercial fallback, ~USD 5 external budget)
# The paid model MUST be explicitly pinned (no default is ever guessed).
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODEL=
OPENROUTER_STRUCTURED_OUTPUT_MODE=json_object

# ============================================================================
# Application Settings
# ============================================================================
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
RATE_LIMIT_PER_MINUTE=60
AI_RATE_LIMIT_PER_MINUTE=10

# ============================================================================
# Caddy Configuration
# ============================================================================
CADDY_DOMAIN=localhost
CADDY_EMAIL=admin@example.com

# ============================================================================
# Demo Data
# ============================================================================
SEED_GOLDEN_DATASET=true
DEMO_RESET_ALLOWED=true
