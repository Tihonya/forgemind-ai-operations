{
  "story_id": "HARNESS-B",
  "title": "Harness Validation: Scenario B — required test missing",
  "description": "Validates FAIL when required targeted test file does not exist",
  "branch": "chore/agent-loop-infrastructure",
  "gates": {
    "scope": {
      "required": true,
      "enabled": true
    },
    "json_syntax": {
      "required": true,
      "enabled": true
    },
    "targeted_tests": {
      "required": true,
      "enabled": true,
      "assertion_gate": true
    },
    "lint": {
      "required": true,
      "enabled": true,
      "scope_to_diff": true
    },
    "secrets": {
      "required": true,
      "enabled": true,
      "scope_to_diff": true
    },
    "git_diff_check": {
      "required": false,
      "enabled": true
    }
  },
  "test_commands": {
    "targeted_args": [
      "tests/synthetic/test_nonexistent_harness.py",
      "-v",
      "--junitxml={report_file}"
    ]
  }
}
