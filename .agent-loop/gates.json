{
  "schema_version": "1.0",
  "project_id": "forgemind",
  "gates": {
    "scope": {
      "enabled": true,
      "required": true,
      "description": "Verify changes within allowed paths"
    },
    "json_syntax": {
      "enabled": true,
      "required": true,
      "description": "JSON file syntax validation"
    },
    "yaml_syntax": {
      "enabled": true,
      "required": true,
      "description": "YAML file syntax validation"
    },
    "targeted_tests": {
      "enabled": true,
      "required": true,
      "assertion_gate": true,
      "description": "Targeted test execution with assertion gate"
    },
    "lint": {
      "enabled": true,
      "required": true,
      "scope_to_diff": true,
      "description": "Ruff + mypy lint checks"
    },
    "secrets": {
      "enabled": true,
      "required": true,
      "scope_to_diff": true,
      "description": "Scan for accidentally committed secrets"
    },
    "git_diff_check": {
      "enabled": true,
      "required": true,
      "description": "Whitespace and conflict marker check"
    }
  }
}
