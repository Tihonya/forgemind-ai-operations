# ForgeMind AI Operations — Isolated Demo environment template (WP-P7-03, DEC-056)
#
# SAFETY CONTRACT:
# - This file contains variable NAMES and non-secret placeholders ONLY.
# - It is a template for the demo deployment-time secret workflow; the real
#   demo .env lives OUTSIDE the repository (never committed, chmod 600).
# - Copy to infra/demo.env and replace EVERY placeholder before running the
#   demo or a reset (scripts/demo-reset.sh uses this file).
# - The demo database NAME is NOT here — it is hard-coded to
#   ``forgemind_demo`` in docker-compose.demo.yml, so the demo cannot be
#   pointed at an arbitrary/production database by configuration.
#
# The Demo runs ENVIRONMENT=production (real security/provider behavior)
# against synthetic data; provider decisions match the production contract
# (PD-3 / PD-3a): chat = OpenRouter only, embedding = OpenRouter via the
# OpenAI-compatible endpoint, 1536 dimensions. Real AI provider calls are
# allowed at deployed demo runtime; real BUSINESS side effects are forbidden.

# ---------------------------------------------------------------------------
# Deployment identity (required)
# ---------------------------------------------------------------------------
# Demo FQDN — Product Owner deployment-time input. Do NOT fabricate.
# The production FQDN must NOT be reused here: demo and production are
# isolated Compose projects and must not share a public origin.
CADDY_DOMAIN=replace-with-demo-fqdn.example
CADDY_EMAIL=replace-with-tls-contact@example.com

# ---------------------------------------------------------------------------
# Core secrets (required — never commit real values)
# ---------------------------------------------------------------------------
# JWT signing secret — at least 32 random characters.
# PASSWORD POLICY: POSTGRES_PASSWORD / REDIS_PASSWORD are interpolated
# verbatim into DATABASE_URL / REDIS_URL; use only URL-safe characters
# A-Z a-z 0-9 . _ ~ - (see docs/infra-production.md password policy).
SECRET_KEY=REPLACE_WITH_RANDOM_32_PLUS_CHARS
POSTGRES_USER=forgemind
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD

# ---------------------------------------------------------------------------
# Providers (required — never commit real values)
# ---------------------------------------------------------------------------
# Both provider keys are required explicitly (no implicit reuse):
#   - OPENAI_API_KEY holds the OpenRouter key for the EMBEDDING path;
#   - OPENROUTER_API_KEY holds the key for the CHAT path.
OPENAI_API_KEY=REPLACE_WITH_OPENROUTER_KEY
OPENROUTER_API_KEY=REPLACE_WITH_OPENROUTER_KEY

# Embedding path (PD-3a — exact values required)
EMBEDDING_PROVIDER=openai
OPENAI_API_BASE=https://openrouter.ai/api/v1
OPENAI_EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Chat path (PD-3 — exact values required)
CHAT_PROVIDER_MODE=openrouter
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODEL=qwen/qwen3.7-flash
OPENROUTER_STRUCTURED_OUTPUT_MODE=json_object

# ---------------------------------------------------------------------------
# Rate limiting (production-safe shared limiting — required)
# ---------------------------------------------------------------------------
DISTRIBUTED_RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEGRADED_MODE=fail_closed
RATE_LIMIT_PER_MINUTE=60
AI_RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_WINDOW_SECONDS=60

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=/api/v1
CORS_ORIGINS=https://REPLACE_WITH_DEMO_FQDN.example
