# ForgeMind AI Operations — Production environment template (WP-P7-02)
#
# SAFETY CONTRACT:
# - This file contains variable NAMES and non-secret placeholders ONLY.
# - It is a template for the deployment-time secret workflow; the real
#   production .env lives OUTSIDE the repository (on the VPS, owned by
#   the dedicated deployment user, chmod 600) and is never committed.
# - Copy to the deployment directory and replace EVERY placeholder.
# - Before any deployment action, run:
#       python -m app.ops.validate_config
#   (fail-closed: exits non-zero until every Release 1 rule passes).
#
# Provider decisions recorded by the Phase 7 contract (PD-3 / PD-3a):
#   Chat:      OpenRouter ONLY, qwen/qwen3.7-flash, json_object,
#              automatic fallback DISABLED.
#   Embedding: EMBEDDING_PROVIDER=openai
#              OPENAI_API_BASE=https://openrouter.ai/api/v1
#              OPENAI_EMBEDDING_MODEL=openai/text-embedding-3-small
#              EMBEDDING_DIMENSIONS=1536
#              OPENAI_API_KEY holds the OpenRouter key.

# ---------------------------------------------------------------------------
# Deployment identity (required)
# ---------------------------------------------------------------------------
# Production FQDN — Product Owner deployment-time input. Do NOT fabricate.
CADDY_DOMAIN=replace-with-production-fqdn.example
# TLS contact email for Caddy automatic HTTPS (Let's Encrypt).
CADDY_EMAIL=replace-with-tls-contact@example.com

# ---------------------------------------------------------------------------
# Core secrets (required — never commit real values)
# ---------------------------------------------------------------------------
# JWT signing secret — at least 32 random characters.
# PASSWORD POLICY (Release 1): POSTGRES_PASSWORD / REDIS_PASSWORD are
# interpolated verbatim into DATABASE_URL / REDIS_URL, so they may
# contain ONLY the URL-safe characters A-Z a-z 0-9 . _ ~ - .
# Characters like @ : / # % or spaces silently corrupt the URLs and are
# REJECTED by the production config validator. The validator, this
# template, and the Compose interpolation therefore agree on one rule
# (see docs/infra-production.md §2.1).
SECRET_KEY=REPLACE_WITH_RANDOM_32_PLUS_CHARS
POSTGRES_DB=forgemind
POSTGRES_USER=forgemind
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD

# ---------------------------------------------------------------------------
# Providers (required — never commit real values)
# ---------------------------------------------------------------------------
# BOTH provider keys are required explicitly — the runtime does NOT
# reuse one key for the other (no implicit fallback per PD-3/PD-3a):
#   - OPENAI_API_KEY holds the OpenRouter key for the EMBEDDING path;
#   - OPENROUTER_API_KEY holds the key for the CHAT path.
# A single OpenRouter account may supply the same key value to both
# fields, but both fields must be set to real values.
OPENAI_API_KEY=REPLACE_WITH_OPENROUTER_KEY
OPENROUTER_API_KEY=REPLACE_WITH_OPENROUTER_KEY

# Embedding path (PD-3a — exact values required)
EMBEDDING_PROVIDER=openai
OPENAI_API_BASE=https://openrouter.ai/api/v1
OPENAI_EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Chat path (PD-3 — exact values required)
CHAT_PROVIDER_MODE=openrouter
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODEL=qwen/qwen3.7-flash
OPENROUTER_STRUCTURED_OUTPUT_MODE=json_object

# ---------------------------------------------------------------------------
# Rate limiting (production-safe shared limiting — required)
# ---------------------------------------------------------------------------
DISTRIBUTED_RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEGRADED_MODE=fail_closed
RATE_LIMIT_PER_MINUTE=60
AI_RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_WINDOW_SECONDS=60

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# Served under the same public origin; the nginx container proxies
# /api to the backend through Caddy.
VITE_API_BASE_URL=/api/v1
CORS_ORIGINS=https://REPLACE_WITH_PRODUCTION_FQDN.example
